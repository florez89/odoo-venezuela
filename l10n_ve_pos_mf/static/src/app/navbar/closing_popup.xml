<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_mf.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-on-click, 'cashMove')]" position="before">
            <t t-if="pos.useFiscalMachine()">
                <button class="button btn btn-secondary ve-mf-report-z" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'" t-on-click="generate_report_z" title="Print the Z report">Report Z</button>
                <button class="button btn btn-secondary ve-mf-report-x" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'" t-on-click="generate_report_x" title="Print the X report">Report X</button>
            </t>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_mf.DebugWidget" t-inherit="point_of_sale.DebugWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('debug-orders')]" position="before">
            <div t-if="pos.useFiscalMachine()" class="debug-fiscal-machine">
                <h5 class="category">Fiscal Machine</h5>
                <ul class="mb-3">
                    <li class="button btn btn-link" t-on-click="fiscalProgramming">Programming</li>
                    <li class="button btn btn-link" t-on-click="fiscalReportX">Report X</li>
                </ul>
            </div>
        </xpath>
    </t>
</templates>

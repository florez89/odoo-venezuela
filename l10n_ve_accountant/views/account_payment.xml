<odoo>
    <record id="view_account_payment_form_inherit_l10n_ve_accountant" model="ir.ui.view">
        <field name="name">view.account.payment.form.inherit.l10n.ve.accountant</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0" role="alert"
                    invisible="not is_foreign_rate_outdated or state != 'draft'">
                    The exchange rate of this payment is from <field name="foreign_rate_date" class="oe_inline"/>,
                    <field name="foreign_rate_age_days" class="oe_inline"/> days old. Update the exchange rates
                    or confirm that it is the rate in force when confirming.
                </div>
            </xpath>
            <!-- Only the form asks to confirm an outdated rate: code posting payments is not stopped.
                 The Odoo 18 core Confirm button has no context of its own. -->
            <xpath expr="//header/button[@name='action_post']" position="attributes">
                <attribute name="context">{'l10n_ve_check_rate_age': True}</attribute>
            </xpath>
            <field name="partner_bank_id" position="after">
                <field name="foreign_rate" readonly="state == 'posted'" />
                <field name="foreign_inverse_rate" invisible="1" />
                <field name="foreign_inverse_rate" groups="base.group_no_one" />
            </field>
            <field name="memo" position="after">
                <field name="concept" />
            </field>
        </field>
    </record>
    <record id="view_account_payment_search_inherit_l10n_ve_accountant" model="ir.ui.view">
        <field name="name">view.account.payment.search.inherit.l10n.ve.accountant</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inbound_filter']" position="attributes">
                <attribute name="string">Customer collections</attribute>
            </xpath>
        </field>
    </record>
</odoo>
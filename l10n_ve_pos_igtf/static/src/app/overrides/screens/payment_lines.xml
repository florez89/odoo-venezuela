<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_igtf.PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='props.paymentLines']" position="inside">
            <div t-if="line.igtfDetails and line.igtfDetails.igtf" class="ve-igtf d-flex align-items-center ps-3 pb-2">
                <span class="border rounded px-2">IGTF = <span class="ve-igtf-amount" t-esc="formatIgtfAmount(line)"/></span>
            </div>
        </xpath>
    </t>
</templates>

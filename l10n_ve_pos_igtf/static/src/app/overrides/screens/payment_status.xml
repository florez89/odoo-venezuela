<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_igtf.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-container')]" position="after">
            <div t-if="igtfDetails.igtf" class="ve-igtf-status d-flex justify-content-between fs-5 pe-4 me-2">
                <span>BI IGTF: <span class="ve-bi-igtf" t-esc="biIgtfText"/></span>
                <span>IGTF: <span class="ve-igtf-total" t-esc="igtfAmountText"/>
                    <t t-if="foreignIgtfText"> / <t t-esc="foreignIgtfText"/></t>
                </span>
            </div>
        </xpath>
    </t>
</templates>

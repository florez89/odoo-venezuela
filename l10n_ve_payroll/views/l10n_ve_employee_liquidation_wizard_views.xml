<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ve_employee_liquidation_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ve.employee.liquidation.wizard.form</field>
        <field name="model">l10n_ve.employee.liquidation.wizard</field>
        <field name="arch" type="xml">
            <form string="Preparar Liquidación de Empleado">
                <sheet>
                    <group>
                        <field name="employee_id" readonly="1" />
                        <field name="exit_date" />
                        <field name="exit_reason" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>

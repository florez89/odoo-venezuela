<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View for Préstamos -->
        <record id="view_l10n_ve_loan_form" model="ir.ui.view">
            <field name="name">l10n_ve.loan.form</field>
            <field name="model">l10n_ve.loan</field>
            <field name="arch" type="xml">
                <form string="Préstamo a Trabajador">
                    <header>
                        <button name="action_approve" type="object" string="Aprobar Préstamo" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('paid', 'cancelled')"/>
                        <button name="action_draft" type="object" string="Volver a Borrador" invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Información del Solicitante">
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Detalles del Préstamo">
                                <field name="amount" readonly="state != 'draft'"/>
                                <field name="installments" readonly="state != 'draft'"/>
                                <field name="installment_amount"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Estado de Pagos">
                                <field name="paid_amount"/>
                                <field name="balance_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Cuotas del Préstamo" name="lines">
                                <field name="line_ids" readonly="1">
                                    <list string="Cuotas" decoration-success="paid == True">
                                        <field name="sequence"/>
                                        <field name="amount"/>
                                        <field name="paid"/>
                                        <field name="payslip_id"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Observaciones" name="notes">
                                <field name="notes" placeholder="Motivo o justificación del préstamo..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View for Préstamos -->
        <record id="view_l10n_ve_loan_list" model="ir.ui.view">
            <field name="name">l10n_ve.loan.list</field>
            <field name="model">l10n_ve.loan</field>
            <field name="arch" type="xml">
                <list string="Préstamos a Trabajadores" decoration-muted="state == 'cancelled'" decoration-success="state == 'paid'" decoration-info="state == 'approved'">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="amount" sum="Total Préstamos"/>
                    <field name="installments"/>
                    <field name="installment_amount"/>
                    <field name="paid_amount" sum="Total Pagado"/>
                    <field name="balance_amount" sum="Total Saldo"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Action for Préstamos -->
        <record id="action_l10n_ve_loan" model="ir.actions.act_window">
            <field name="name">Préstamos a Trabajadores</field>
            <field name="res_model">l10n_ve.loan</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registrar un nuevo préstamo a un trabajador.
                </p>
            </field>
        </record>

        <!-- Menu Item for Préstamos -->
        <menuitem id="menu_l10n_ve_loan"
                  name="Préstamos a Trabajadores"
                  parent="hr_payroll.menu_hr_payroll_employees_root"
                  action="action_l10n_ve_loan"
                  sequence="25"/>
    </data>
</odoo>

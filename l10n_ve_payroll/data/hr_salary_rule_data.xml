        <!-- LPP (Ley de Protección de Pensiones) - Patrono (Aporte 9%) -->
        <record id="hr_salary_rule_ve_lpp_patrono" model="hr.salary.rule">
            <field name="name">Aporte LPP Patrono (9%)</field>
            <field name="code">APO_LPP</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="struct_id" ref="hr_payroll.structure_002"/>
            <field name="sequence" type="int">204</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
param = payslip._get_active_ve_parameter()
if not param:
    result = 0.0
else:
    # Floor is param.pension_min_base USD indexed, converted to VES using the payslip's BCV rate
    min_base_ves = param.pension_min_base * payslip.l10n_ve_bcv_rate
    gross = categories.get('GROSS', 0.0) or payslip.wage_in_ves
    calculation_base = max(gross, min_base_ves)
    result = (calculation_base * (param.pension_rate / 100.0))
            </field>
        </record>


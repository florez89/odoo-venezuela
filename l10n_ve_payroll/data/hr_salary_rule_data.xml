            <field name="sequence" type="int">104</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
param = payslip._get_active_ve_parameter()
if not param:
    result = 0.0
else:
    util_amount = 0.0
    try:
        util_amount = UTIL
    except Exception:
        try:
            util_amount = AGUI
        except Exception:
            pass
    
    if util_amount <= 0.0:
        result = 0.0
    else:
        result = - (util_amount * (param.inces_employee_rate / 100.0))
            ]]></field>
        </record>


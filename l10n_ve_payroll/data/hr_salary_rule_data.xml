        <!-- IVSS (Seguro Social) - Trabajador (Deducción 4%) -->
        <record id="hr_salary_rule_ve_ivss_trabajador" model="hr.salary.rule">
            <field name="name">Deducción IVSS (4%)</field>
            <field name="code">DED_IVSS</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="struct_id" ref="hr_payroll.structure_002"/>
            <field name="sequence" type="int">101</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
param = payslip._get_active_ve_parameter()
if not param:
    result = 0.0
else:
    mondays = payslip._get_mondays_in_period(payslip.date_from, payslip.date_to)
    weekly_wage = (payslip.wage_in_ves * 12.0) / 52.0
    weekly_ceiling = (param.ivss_limit_weeks * param.salario_minimo * 12.0) / 52.0
    weekly_base = min(weekly_wage, weekly_ceiling)
    result = - (weekly_base * (param.ivss_employee_rate / 100.0) * mondays)
            </field>
        </record>


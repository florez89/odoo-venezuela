param = payslip._get_active_ve_parameter()
if not param:
    result = 0.0
else:
    completed_years, fractional_months = payslip._get_liquidation_months_and_years()
    seniority_year = completed_years + 1
    vac_days = param.vacation_days_base + (seniority_year - 1)
    vac_days = min(vac_days, param.vacation_days_max)
    daily_wage = payslip.wage_in_ves / 30.0
    result = ((fractional_months / 12.0) * vac_days) * daily_wage
            </field>

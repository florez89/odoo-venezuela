<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//span[@t-esc='orderAmountPlusTip']" position="after">
            <t t-if="currentOrder.foreignCurrency">
                / <span class="ve-foreign-total" t-esc="env.utils.formatForeignCurrency(currentOrder.get_foreign_total_with_tax())"/>
            </t>
        </xpath>
    </t>
</templates>

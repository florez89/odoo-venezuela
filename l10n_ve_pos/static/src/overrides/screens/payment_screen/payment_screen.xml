<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenDue" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="inside">
            <div t-if="pos.foreignCurrency" class="ve-foreign-due fs-4">
                <t t-esc="env.utils.formatForeignCurrency(currentOrder.get_foreign_total_with_tax())"/>
            </div>
        </xpath>
    </t>
</templates>

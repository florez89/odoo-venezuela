<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//OrderWidget" position="attributes">
            <attribute name="foreignSummary">_selectedSyncedOrder.getForeignSummary()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <FullRefundButton order="_selectedSyncedOrder" ticketScreen="this"/>
        </xpath>
    </t>
</templates>

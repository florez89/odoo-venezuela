<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-total')]" position="after">
            <div t-if="props.data.foreign_amount_total_text" class="pos-receipt-amount ve-foreign-total">
                TOTAL
                <span t-esc="props.data.foreign_amount_total_text" class="pos-receipt-right-align"/>
            </div>
            <div t-if="props.data.foreign_rate_text" class="ve-foreign-rate">
                Rate: <span t-esc="props.data.foreign_rate_text" class="pos-receipt-right-align"/>
            </div>
        </xpath>
    </t>
</templates>

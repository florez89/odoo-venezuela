<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-remaining')]/span[hasclass('amount')]" position="inside">
            <t t-if="pos.foreignCurrency">
                / <span class="ve-foreign-remaining" t-esc="foreignRemainingText"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('payment-status-change')]/span[hasclass('amount')]" position="inside">
            <t t-if="pos.foreignCurrency">
                / <span class="ve-foreign-change" t-esc="foreignChangeText"/>
            </t>
        </xpath>
    </t>
</templates>

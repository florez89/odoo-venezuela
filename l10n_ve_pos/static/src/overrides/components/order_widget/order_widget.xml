<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.OrderWidget" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]" position="inside">
            <t t-set="foreignSummary" t-value="props.foreignSummary"/>
            <div t-if="foreignSummary" class="ve-foreign-summary d-flex justify-content-between w-100 fs-6 fw-normal text-muted">
                <div class="text-start">
                    <div class="ve-foreign-rate">Rate: <t t-esc="foreignSummary.rate"/></div>
                    <div class="ve-products-quantity">Products: <t t-esc="foreignSummary.quantity"/></div>
                </div>
                <div class="text-end">
                    <div>Total: <span class="ve-foreign-total" t-esc="foreignSummary.total"/></div>
                    <div t-if="foreignSummary.tax">Taxes: <span class="ve-foreign-tax" t-esc="foreignSummary.tax"/></div>
                </div>
            </div>
        </xpath>
    </t>
</templates>

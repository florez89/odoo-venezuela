<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-price')]" position="inside">
            <t t-if="line.foreignPrice">
                / <span class="ve-foreign-price" t-esc="line.foreignPrice"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('product-name')]/t[@t-slot='product-name']" position="before">
            <span t-if="line.aliquotType" class="ve-aliquot-type ms-1" t-esc="line.aliquotType"/>
        </xpath>
    </t>
</templates>
